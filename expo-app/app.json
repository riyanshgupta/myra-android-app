{
  "expo": {
    "name": "Myra Music AI",
    "slug": "myra-android-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#10131a",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.myra.music.ai"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow Myra AI to record audio for voice commands."
        }
      ]
    ]
  }
}
